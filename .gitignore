run.log
.DS_Store
*.pyc
__pycache__/
.venv/
.venv-head/
.ruff_cache/
.pytest_cache/
*.egg-info/
dist/
uv.lock

# Recordings & render output (large, regenerable by record_*.py / record_policy.py)
logs/
*.rrd
*.rbl
*.mp4
*.json
*_gs/
!pyproject.toml

# Training output (logs + checkpoints, regenerable by train_ppo.py)
runs/

# ---- Model checkpoints (never commit; regenerable by the trainers) ----
*.pt
*.pth
*.ckpt

# ---- Editor / agent workspace ----
.claude/

# ---- Rollout recordings (regenerable; .rrd/.rbl already ignored above) ----
*.npz
*.npy

# The golden-regression baseline is NOT a regenerable recording: it pins the
# kinematic arm path across parent-env edits (tests/test_golden_kinematic.py).
!tests/golden_kinematic.npz

# ---- Datagen / render output trees (regenerable by tools/render_*.sh, tools/*_pipeline.sh) ----
datagen_*/
out_*/

# ---- mesh2splat intermediates: 200MB+ of bake, re-derivable from the scan with
#      tools/bake_jack_v2.py; nothing in the repo loads them ----
newton_cabling/assets/ethernet/*_m2s_*.ply
